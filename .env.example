NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-share"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

AI_PROVIDER="gemini"
AI_API_KEY="your-ai-api-key"
AI_MODEL="gemini-flash-latest"

MAX_CONTENT_DURATION_SECONDS="7200"

YOUTUBE_TRANSCRIPT_PROVIDER=supadata
SUPADATA_API_KEY=

# YouTube Data API v3. Server-only, never use NEXT_PUBLIC_
# Required for duration validation and accurate video status.
# Without this key, Verbatim falls back to oEmbed (no duration enforcement).
# Get a key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_DATA_API_KEY=

# Feedback form email notifications (optional). Without these, feedback is
# still saved to the database and readable in /admin/feedback.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# --- AI cost controls -------------------------------------------------------
# Pin an exact model. Aliases like gemini-flash-latest can be repointed by
# Google to a newer, pricier model without notice. Pricing per model lives in
# utils/ai/pricing.ts; override with AI_PRICE_INPUT_PER_M / AI_PRICE_AUDIO_PER_M
# / AI_PRICE_OUTPUT_PER_M (USD per 1M tokens) if your price differs.
# AI_MODEL="gemini-2.5-flash"

# auto (default): analyse the transcript as text when there is one, watch the
# video only when there isn't (~25-40x cheaper). video: always watch the video.
AI_ANALYSIS_MODE=auto
# Thinking tokens are billed as output. Default budget is 1024 tokens.
# Set a number, "off" (model default), or AI_THINKING_LEVEL=LOW for Gemini 3.
AI_THINKING_BUDGET=
AI_MAX_OUTPUT_TOKENS=16384
# Per-call timeout; keep under the 300 s maxDuration of the analysis pages.
AI_TIMEOUT_MS=270000
# Same video analysed again (by anyone) reuses the result for this many days. 0 = off.
AI_CACHE_TTL_DAYS=30
TRANSCRIPT_CACHE_DAYS=30
# Hard daily spend caps in USD (estimated). Unset = no cap.
AI_DAILY_BUDGET_USD=
AI_USER_DAILY_BUDGET_USD=
# Analyses allowed to run at the same time across all users (default 5). Each
# account can only run one at a time, so parallel runs can't slip past the caps.
AI_MAX_CONCURRENT_ANALYSES=
# Optional flat cost per Supadata transcript call, for the cost dashboard.
SUPADATA_COST_PER_CALL_USD=

# Log every ingest/analysis step with timings to the server console.
VERBATIM_DEBUG=
