# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template has placeholder values only and should be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
logs/

# editors and OS
.vscode/
.idea/
*.swp
Thumbs.db

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# design-taste inspector output (screenshots and reports)
.taste-skill/

# AI coding tool local config
.aider-desk/

# local debug scripts
_probe*.mjs

# AI agent skills and assistant config (installed locally per developer)
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
CLAUDE.local.md
.claude/

# Private developer notes and tools (never committed)
PROJECT_NOTES.md
scripts/private/
